local function PlaceItemFromQuest(itemName, quantity)
    quantity = quantity or 1
    local placed = 0

    local ok = pcall(function()
        local ClientRestaurant = GetClientRestaurant()
        local Network = GetNetwork()
        local Types = GetEntityTypesModule()

        if not ClientRestaurant or not Network or not Types then
            Log("⚠ Place: required modules not loaded")
            return
        end

        local restaurant = ClientRestaurant.GetLocal()
        if not restaurant then
            Log("⚠ Place: restaurant not found")
            return
        end

        local stock = GetItemStock(itemName)
        if stock <= 0 then
            Log(string.format("⚠ Place: no stock for '%s', beli dulu sebelum bisa diplace", itemName))
            return
        end

        local toPlace = math.min(quantity, stock)
        local floor = GetPlayerFloor(restaurant)

        for i = 1, toPlace do
            local voxels = GetGenericPlaceableVoxels(restaurant, floor, Types)

            if #voxels == 0 then
                Log("⚠ Place: no empty placeable tile found on this floor")
                break
            end

            local voxel = voxels[1]

            local success = pcall(function()
                Network.Fire("Build_Place", itemName, voxel.X, voxel.Y, 0, floor)
            end)

            if not success then
                Log(string.format("⚠ Place failed: '%s'", itemName))
                break
            end

            placed = placed + 1
            Log(string.format("✓ Placed: %s (%d/%d) @ (%d,%d) floor %d", itemName, placed, toPlace, voxel.X, voxel.Y, floor))
            task.wait(0.35)
        end
    end)

    if not ok then
        Log("⚠ Error during place attempt for '" .. tostring(itemName) .. "'")
    end

    return placed > 0
end

-- ============================================================
-- AUTO HIRE EMPLOYEE (REAL implementation, v2.1)
--
-- IsEmployeeOwned / PurchaseEmployee: cek udah punya belum lewat
-- EntityUtil.EmployeeSubclasses, cek unlocked lewat
-- ProgressionUtil.IsEmployeeUnlocked, cek cash cukup lewat
-- CurrencyCmds.Get("Cash"), baru Network.Invoke("Employee_Purchase",
-- employeeId). Pattern disamain kayak script Auto Buy Employees user.
-- ============================================================
local function IsEmployeeOwned(employeeDir)
    local EntityUtil = GetEntityUtil()

    if not CachedRestaurant then
        CachedRestaurant = CachedClientRestaurant and CachedClientRestaurant.GetLocal()
    end

    if not CachedRestaurant or not EntityUtil or not EntityUtil.EmployeeSubclasses then
        return false
    end

    local owned = false
    pcall(function()
        for _, subclass in ipairs(EntityUtil.EmployeeSubclasses) do
            for _, emp in ipairs(CachedRestaurant:CollectSubclass(subclass)) do
                if emp:GetDirectory() == employeeDir then
                    owned = true
                    return
                end
            end
        end
    end)

    return owned
end

local function PurchaseEmployee(employeeId, employeeDir)
    local Network = GetNetwork()
    local CurrencyCmds = GetCurrencyCmds()
    local ProgressionUtil = GetProgressionUtil()

    if not Network or not CurrencyCmds or not ProgressionUtil or not employeeDir then
        Log("⚠ Hire: required modules not loaded")
        return false
    end

    if IsEmployeeOwned(employeeDir) then
        Log(string.format("⚠ Hire: '%s' already owned, skip", employeeId))
        return false
    end

    local unlockedOk, unlocked = pcall(function()
        return ProgressionUtil.IsEmployeeUnlocked(LocalPlayer, employeeId)
    end)
    if not unlockedOk or not unlocked then
        Log(string.format("⚠ Hire: '%s' not unlocked yet", employeeId))
        return false
    end

    local price = employeeDir.Price or math.huge
    local cash = 0
    pcall(function()
        cash = CurrencyCmds.Get("Cash") or 0
    end)

    if cash < price then
        Log(string.format("⚠ Hire: not enough cash for '%s' (have %d, need %d)", employeeId, cash, price))
        return false
    end

    local success = pcall(function()
        Network.Invoke("Employee_Purchase", employeeId)
    end)

    if success then
        Log(string.format("✓ Hired: %s", employeeId))
    else
        Log(string.format("⚠ Hire failed: '%s'", employeeId))
    end

    return success
end

-- ============================================================
-- ParseHireGoal (v2.1 REWRITE, berdasarkan decompile ASLI
-- ReplicatedStorage.Framework.Types.GoalTypes).
--
-- Goal untuk quest type 4 (Hire) cuma punya DUA field relevan:
--   Goal.StaffId    -> id spesifik di Entity directory. LANGSUNG valid
--                      sebagai key EntityUtil.Employees[StaffId], karena
--                      Employees dibangun dari Entity directory yang
--                      difilter subclass (JoinSubclass di EntityUtil),
--                      jadi key-nya identik dengan Entity._id. Gak perlu
--                      resolve/fuzzy sama sekali.
--   Goal.StaffClass -> cuma nama subclass generik ("Waiter","Cook",
--                      "Farmer","Cleaner","Rancher","Manager","Fisherman",
--                      "DeliveryDriver"), artinya quest minta hire staff
--                      DARI KELAS itu, bukan employee tertentu.
--
-- Field "EmployeeId" yang dipakai versi lama TIDAK ADA di schema asli --
-- itu akar masalah kenapa deteksi selalu gagal untuk staff selain
-- Cleaner. Text-parsing dari goalData.Name juga dihapus total karena
-- data terstruktur ini jauh lebih reliable.
-- ============================================================
local function ParseHireGoal(goalData)
    local EntityUtil = GetEntityUtil()
    if not EntityUtil or not EntityUtil.Employees then
        return nil, nil
    end

    local goal = goalData.GoalData and goalData.GoalData.Goal
    if not goal then
        return nil, nil
    end

    -- Case 1: StaffId spesifik -> langsung valid sebagai key Employees
    if goal.StaffId and EntityUtil.Employees[goal.StaffId] then
        return goal.StaffId, nil
    end

    -- Case 2: StaffClass generik -> nanti dipilih 1 employee dari kelas
    -- itu yang belum dimiliki, sudah unlocked, dan cash cukup
    if goal.StaffClass then
        return nil, goal.StaffClass
    end

    return nil, nil
end

-- Cari 1 employee manapun dari subclass tertentu yang belum dimiliki,
-- sudah unlocked, dan cash cukup -- dipakai kalau Goal cuma punya
-- StaffClass (generik) tanpa StaffId spesifik.
local function FindHireableFromClass(staffClass)
    local EntityUtil = GetEntityUtil()
    local ProgressionUtil = GetProgressionUtil()
    local CurrencyCmds = GetCurrencyCmds()

    if not EntityUtil or not EntityUtil.Employees or not ProgressionUtil or not CurrencyCmds then
        return nil, nil
    end

    local cash = 0
    pcall(function() cash = CurrencyCmds.Get("Cash") or 0 end)

    for employeeId, employeeDir in pairs(EntityUtil.Employees) do
        if employeeDir.Subclass == staffClass and not IsEmployeeOwned(employeeDir) then
            local unlockedOk, unlocked = pcall(function()
                return ProgressionUtil.IsEmployeeUnlocked(LocalPlayer, employeeId)
            end)
            if unlockedOk and unlocked then
                local price = employeeDir.Price or math.huge
                if cash >= price then
                    return employeeId, employeeDir
                end
            end
        end
    end

    return nil, nil
end

local function HireEmployeeFromQuest(goalData)
    local EntityUtil = GetEntityUtil()
    if not EntityUtil or not EntityUtil.Employees then
        Log("⚠ Hire: EntityUtil module not loaded")
        return false
    end

    local employeeId, staffClass = ParseHireGoal(goalData)

    if employeeId then
        local employeeDir = EntityUtil.Employees[employeeId]
        if not employeeDir then
            Log(string.format("⚠ Hire: '%s' not found in EntityUtil.Employees", employeeId))
            return false
        end
        Log(string.format("Target: hire %s (%s) [StaffId]", employeeId, employeeDir.Subclass or "?"))
        return PurchaseEmployee(employeeId, employeeDir)
    end

    if staffClass then
        local candidateId, candidateDir = FindHireableFromClass(staffClass)
        if not candidateId then
            Log(string.format("⚠ Hire: no hireable '%s' found (owned/locked/cash?)", staffClass))
            return false
        end
        Log(string.format("Target: hire %s (%s) [StaffClass]", candidateId, staffClass))
        return PurchaseEmployee(candidateId, candidateDir)
    end

    Log("⚠ Hire: could not identify employee to hire from quest (no StaffId/StaffClass)")
    return false
end

-- Step 1: Auto Complete Quests Until Level 10
local function AutoCompleteQuests()
    -- v3.1: begitu fase Layout Prep aktif (Service Level 10 + quest Earn
    -- $200 selesai), berhenti total ngejar quest. Base restaurant loop
    -- TETAP jalan (di-enable-nya udah dari panggilan AutoCompleteQuests
    -- sebelumnya & gak pernah dimatiin lagi), cuma logic quest-nya yang
    -- di-skip di sini.
    if QuestAutomationStopped then
        return
    end

    UpdateStatus("Step 1: Auto Completing Quests (Target: Level 10)", Color3.fromRGB(255, 255, 100))
    Log("Starting quest automation...")

    -- ============================================================
    -- v2.2: Sit + TakeOrder + Cooking + Serve + Dish sekarang di-enable
    -- SEKALI di sini dan JALAN TERUS selama Step 1 (sampai Service Level
    -- 10 tercapai), berapapun quest type yang lagi difokuskan oleh
    -- priority system. Dulu keempatnya cuma nyala kalau quest yang lagi
    -- fokus butuh (misal type 1/8/10/5), jadi restoran idle pas quest
    -- fokus lagi Purchase/Hire/Place/Earn -- padahal customer baru tetap
    -- perlu dilayani biar quest lain gak numpuk dan restoran gak macet.
    -- Serve ikut dinyalakan (bukan cuma sit/order/cook/dish yang diminta)
    -- karena tanpa Serve, makanan yang udah dimasak gak pernah diantar --
    -- loop-nya bakal buntu di tengah.
    -- ============================================================
    AutoSitEnabled = true
    AutoTakeOrderEnabled = true
    AutoCookingEnabled = true
    AutoServeEnabled = true
    AutoDishwasherEnabled = true
    Log("→ Base restaurant loop (Sit+Order+Cook+Serve+Dish) enabled for entire Step 1")

    local Saving = GetSaving()
    local GoalCmds = GetGoalCmds()
    local QuestCmds = GetQuestCmds()

    if Saving then
        Log("✓ Saving module loaded")
        local saveData = Saving.Get()
        if saveData then
            Log("✓ Save data available")
            if saveData.Goals then
                local count = 0
                for _ in pairs(saveData.Goals) do count = count + 1 end
                Log(string.format("✓ Goals table found (%d entries)", count))
            else
                Log("⚠ No Goals table in save data")
            end
        else
            Log("⚠ Save data is nil")
        end
    else
        Log("❌ Saving module not found")
    end

    if GoalCmds then
        Log("✓ GoalCmds module loaded")
    else
        Log("⚠ GoalCmds module not found")
    end

    if QuestCmds then
        Log("✓ QuestCmds module loaded")
    else
        Log("⚠ QuestCmds module not found")
    end

    Log("Detecting active quests...")

    while Running and GetServiceLevel() < Config.TargetLevel do
        local currentLevel = GetServiceLevel()
        Log("Current Service Level: " .. currentLevel .. "/" .. Config.TargetLevel)

        local activeGoals = GetActiveGoals()

        if next(activeGoals) then
            local questCount = 0
            for _ in pairs(activeGoals) do
                questCount = questCount + 1
            end
            Log(string.format("Found %d active quest(s)", questCount))

            -- ============================================================
            -- PRIORITY SYSTEM: Focus on ONE quest at a time.
            -- Seleksi dilakukan lewat SelectFocusQuest() -- fungsi yang SAMA
            -- dipakai monitor loop di bawah, jadi GUI dan action selalu
            -- nunjuk ke quest yang identik (fix flicker v1.7).
            -- ============================================================
            local currentQuest = SelectFocusQuest(activeGoals)
            local claimedAnyQuest = false

            if currentQuest then
                if currentQuest.Completed then
                    Log(string.format("🎯 Priority: Claiming completed quest '%s'", currentQuest.Name))
                else
                    Log(string.format("🎯 Priority: Focusing on Type %d quest '%s'", currentQuest.Type or -1, currentQuest.Name))
                end
            end

            if currentQuest then
                local goalData = currentQuest

                if not goalData.Completed then
                    Log(string.format("Quest: %s [%d/%d]", goalData.Name, goalData.Progress, goalData.Amount))
                    Log(string.format("Type: %d | Tag: %s", goalData.Type or 0, goalData.Tag1 or "None"))
                    UpdateQuestDisplay(goalData.Name, goalData.Progress, goalData.Amount)

                    local questType = goalData.Type
                    local success = false

                    -- Goal Type Reference (from GoalTypes decompile):
                    -- 1 = Customer (Serve)   2 = Purchase   3 = Earn
                    -- 4 = Hire   5 = Dish (Clean)   7 = Harvest
                    -- 8 = ServeRecipe   10 = Cook   12 = Place

                    if questType == 1 or questType == 8 then
                        -- Base loop (Sit/Order/Cook/Serve/Dish) sudah always-on
                        -- dari awal Step 1, quest ini otomatis progress sambil
                        -- restoran jalan seperti biasa.
                        Log("→ Serve quest in progress (base loop already running)...")
                        success = true

                    elseif questType == 10 then
                        -- Cooking sudah always-on, tinggal nunggu progress
                        Log("→ Cook quest in progress (base loop already running)...")
                        success = true

                    elseif questType == 3 then
                        Log("→ Enabling auto-claim earnings (cash register/tip jar/ice cream)...")
                        AutoClaimEarningsEnabled = true
                        success = true

                    elseif questType == 4 then
                        -- Hire quest (v2.1 FIX) - Goal.StaffId / Goal.StaffClass
                        -- dibaca langsung dari struktur asli, bukan tebak dari teks.
                        Log("→ Hiring employee from quest...")

                        success = HireEmployeeFromQuest(goalData)

                        if success then
                            Log("✓ Hire completed")
                            task.wait(1)
                        else
                            Log("⚠ Hire failed, will retry...")
                            task.wait(2)
                        end

                    elseif questType == 12 then
                        Log("→ Placing item from quest...")

                        local itemName, quantity = ParsePlaceGoal(goalData)
                        if itemName then
                            Log(string.format("Target: %s x%d", itemName, quantity))
                            success = PlaceItemFromQuest(itemName, quantity)

                            if success then
                                Log("✓ Place completed")
                                task.wait(1)
                            else
                                Log("⚠ Place failed, will retry...")
                                task.wait(2)
                            end
                        else
                            Log("⚠ Could not identify item to place")
                        end

                    elseif questType == 5 then
                        -- Dishwasher sudah always-on, tinggal nunggu progress
                        Log("→ Dish quest in progress (base loop already running)...")
                        success = true

                    elseif questType == 7 then
                        Log("→ Harvesting crops...")
                        -- TODO: Add harvest logic

                    elseif questType == 2 then
                        Log("→ Purchasing item from shop...")

                        local itemName, quantity = ParsePurchaseGoal(goalData)
                        if itemName then
                            Log(string.format("Target: %s x%d", itemName, quantity))
                            success = PurchaseItemFromShop(itemName, quantity)

                            if success then
                                Log("✓ Purchase completed")
                                task.wait(1)
                            else
                                Log("⚠ Purchase failed, will retry...")
                                task.wait(2)
                            end
                        else
                            Log("⚠ Could not identify item to purchase")
                        end

                    else
                        -- Base loop sudah always-on, cukup log & tetap progress
                        Log(string.format("→ Unknown type %d, base loop already running...", questType or 0))
                        success = true
                    end

                    if success then
                        Log("✓ Action executed")
                    end

                    task.wait(0.5)
                else
                    Log(string.format("✓ Quest completed! Claiming: %s", goalData.Name))

                    local cacheKey = "QUEST_" .. goalData.GoalId
                    local lastClaimed = ClaimedQuestCache[cacheKey] or 0

                    if tick() - lastClaimed > 5 then
                        ClaimedQuestCache[cacheKey] = tick()

                        pcall(function()
                            local QuestCmds = GetQuestCmds()
                            local QuestDirectory = GetQuestDirectory()

                            if QuestCmds and QuestDirectory then
                                if goalData.GoalData and goalData.GoalData.Tag2 then
                                    local questData = QuestDirectory[goalData.GoalData.Tag2]

                                    if questData then
                                        QuestCmds.ClaimReward(questData, goalData.GoalId)
                                        Log("✓ Claimed quest reward (GUI safe)")
                                        claimedAnyQuest = true
                                        task.wait(1)
                                    else
                                        Log("⚠ Quest data not found in directory")
                                    end
                                else
                                    Log("⚠ Quest Tag2 not found, trying Goals_Claim fallback")
                                    if CachedNetwork then
                                        CachedNetwork.Invoke("Goals_Claim", goalData.GoalId)
                                        Log("✓ Claimed goal reward")
                                        claimedAnyQuest = true
                                        task.wait(2)
                                    end
                                end
                            else
                                Log("⚠ QuestCmds or Quest directory not loaded")
                            end
                        end)

                        -- v3.1: deteksi quest "Earn $200 Cash" (quest #11)
                        -- kekelar SESI INI -- dipakai bareng skill Service
                        -- Level 10 buat trigger fase Layout Prep.
                        if claimedAnyQuest and goalData.Type == 3 and goalData.Amount == 200 then
                            Earn200QuestDone = true
                            Log("🏁 Quest Earn $200 (quest #11) berhasil diklaim!")
                        end
                    else
                        Log("⚠ Quest recently claimed, skipping (anti-spam)")
                    end
                end
            else
                Log("⚠ No quest selected (should not happen)")
            end

            if claimedAnyQuest then
                Log("Re-scanning for new quests...")
                task.wait(0.5)
                continue
            end
        else
            -- Base loop sudah always-on sejak awal Step 1, gak perlu di-set lagi
            Log("No active quests detected, base restaurant loop still running...")
        end

        task.wait(Config.CheckInterval)
    end

    if GetServiceLevel() >= Config.TargetLevel then
        Log("Reached Service Level " .. Config.TargetLevel .. "!")

        pcall(function()
            local Network = require(ReplicatedStorage.Framework.Client.Network)
            Network.Invoke("Plot_Buy")
            Log("Plot purchased")
            task.wait(1)
        end)

        pcall(function()
            local Network = require(ReplicatedStorage.Framework.Client.Network)
            Network.Invoke("Farming_BuyWheat", "Unlimited")
            Log("Unlimited wheat purchased")
        end)

        CurrentStep = 2
    end
end

-- Step 2: Import Layout Code
local function ImportLayout()
    if Config.LayoutCode == "" or Config.LayoutCode == "Paste Layout Code Here..." then
        UpdateStatus("Step 2: Waiting for Layout Code", Color3.fromRGB(255, 255, 100))
        Log("Please paste your layout code and click Start again")
        Running = false
        return false
    end

    UpdateStatus("Step 2: Importing Layout", Color3.fromRGB(255, 255, 100))
    Log("Importing layout code...")

    pcall(function()
        local success, err = pcall(function()
            loadstring(Config.LayoutCode)()
        end)

        if success then
            Log("Layout code imported successfully")
            CurrentStep = 3
        else
            Log("Error importing layout: " .. tostring(err))
            return false
        end
    end)

    return true
end

-- Step 3: Check Wheat and Apply Layout
local function CheckWheatAndApplyLayout()
    UpdateStatus("Step 3: Checking Wheat Status", Color3.fromRGB(255, 255, 100))
    Log("Checking if wheat is ready...")

    local wheatReady = false
    while Running and not wheatReady do
        pcall(function()
            local playerData = LocalPlayer:FindFirstChild("PlayerData")
            if playerData then
                local wheat = playerData:FindFirstChild("Wheat")
                if wheat and wheat.Value > 0 then
                    wheatReady = true
                end
            end
        end)

        if not wheatReady then
            Log("Wheat not ready yet, waiting...")
            task.wait(5)
        end
    end

    if wheatReady then
        Log("Wheat is ready! Applying layout...")

        pcall(function()
            local applyLayoutEvent = ReplicatedStorage:FindFirstChild("ApplyLayout") or
                                    ReplicatedStorage:FindFirstChild("Remotes"):FindFirstChild("ApplyLayout")
            if applyLayoutEvent then
                applyLayoutEvent:FireServer(Config.LayoutCode)
                Log("Layout applied successfully")
            end
        end)

        if Config.AutoRejoinOnLayoutChange then
            Log("Rejoining game in 3 seconds...")
            task.wait(3)
            TeleportService:Teleport(game.PlaceId, LocalPlayer)
        end

        CurrentStep = 4
    end
end

-- Step 4: Auto Harvest and Sell
local function AutoHarvestAndSell()
    UpdateStatus("Step 4: Auto Harvesting & Selling", Color3.fromRGB(100, 255, 100))
    Log("Starting auto harvest and sell loop...")

    while Running do
        pcall(function()
            local harvestEvent = ReplicatedStorage:FindFirstChild("Harvest") or
                                ReplicatedStorage:FindFirstChild("Remotes"):FindFirstChild("Harvest")
            if harvestEvent then
                harvestEvent:FireServer()
            end

            task.wait(0.5)
            local sellEvent = ReplicatedStorage:FindFirstChild("Sell") or
                             ReplicatedStorage:FindFirstChild("Remotes"):FindFirstChild("Sell")
            if sellEvent then
                sellEvent:FireServer()
            end

            local playerData = LocalPlayer:FindFirstChild("PlayerData")
            if playerData then
                local inventory = playerData:FindFirstChild("Inventory")
                if inventory then
                    local totalItems = 0
                    for _, item in pairs(inventory:GetChildren()) do
                        if item:IsA("IntValue") or item:IsA("NumberValue") then
                            totalItems = totalItems + item.Value
                        end
                    end

                    if totalItems == 0 then
                        Log("All ingredients sold (Inventory: 0)")
                    else
                        Log("Inventory: " .. totalItems .. " items")
                    end
                end
            end
        end)

        task.wait(1)
    end
end

-- Main Loop
local function MainLoop()
    while Running do
        if CurrentStep == 1 then
            if GetServiceLevel() >= Config.TargetLevel then
                Log("Service Level already " .. GetServiceLevel() .. ", skipping Step 1")
                CurrentStep = 2
            else
                AutoCompleteQuests()
            end
        elseif CurrentStep == 2 then
            if not ImportLayout() then
                break
            end
        elseif CurrentStep == 3 then
            CheckWheatAndApplyLayout()
        elseif CurrentStep == 4 then
            AutoHarvestAndSell()
        end

        task.wait(Config.CheckInterval)
    end
end

