-- ============================================================
-- AUTO HARVEST CROP INTEGRATION (v3.2)
--
-- Integrasi dengan auto harvest.lua. Harvest crop aktif kalau:
-- - Service skill sudah level 10
-- - Quest "Earn $200" sudah selesai (gak ada lagi di active goals)
-- - Layout sudah di-apply (LayoutPrepTriggered == true)
-- ============================================================
local HarvestLoopRunning = false
local HarvestCooldownUntil = 0
local HarvestInterval = 15
local HarvestRadius = 12

local function IsCropReadyByStage(Crop)
    local ClientCrop = nil
    pcall(function()
        ClientCrop = require(ReplicatedStorage.Framework.Client.ClientEntity.ClientCrop)
    end)
    
    if not ClientCrop then
        return false
    end
    
    local Stage = Crop:GetSession("Stage") or 1
    local StageCount = ClientCrop.GetStageCount(Crop) or 1
    return StageCount <= Stage
end

local function GetReadyCropsWithPos(Restaurant)
    local List = {}
    for _, Crop in ipairs(Restaurant:CollectSubclass("Crop")) do
        if not Crop:IsLocal() then
            continue
        end
        if not IsCropReadyByStage(Crop) then
            continue
        end
        local Model = Crop:GetModel()
        if not Model then
            continue
        end
        local CropName = Model.Name:gsub(" Crop_.+", "")
        -- Harvest semua crop Wheat yang ready
        if CropName == LayoutPrepConfig.WheatCropFamilyName then
            table.insert(List, { Crop = Crop, Pos = Model:GetPivot().Position })
        end
    end
    return List
end

local function InvokeHarvest(Crop)
    local ok, result = pcall(function()
        return Crop:Invoke("CropHarvest")
    end)
    return ok and result ~= false
end

local function HarvestDoWork()
    if not CachedRestaurant then
        CachedRestaurant = CachedClientRestaurant and CachedClientRestaurant.GetLocal()
    end
    
    if not CachedRestaurant then
        return
    end

    local ReadyCrops = GetReadyCropsWithPos(CachedRestaurant)
    if #ReadyCrops == 0 then
        HarvestCooldownUntil = tick() + HarvestInterval
        return
    end

    local HRP = GetRootPart()
    if not HRP then
        return
    end
    
    local RefPos = HRP.Position
    local Nearest, NearestDist = nil, math.huge
    
    for _, Entry in ipairs(ReadyCrops) do
        local Dist = (Entry.Pos - RefPos).Magnitude
        if Dist < NearestDist then
            NearestDist = Dist
            Nearest = Entry
        end
    end

    if not Nearest then
        return
    end

    -- v3.6: Simple TP dari global.lua (WORKING)
    HRP.CFrame = CFrame.new(Nearest.Pos + Vector3.new(0, 3, 0))
    task.wait(0.1)

    -- Harvest semua crop dalam radius
    local harvested = 0
    for _, Entry in ipairs(ReadyCrops) do
        local Dist = (Entry.Pos - Nearest.Pos).Magnitude
        if Dist <= HarvestRadius then
            task.spawn(function()
                if InvokeHarvest(Entry.Crop) then
                    harvested = harvested + 1
                end
            end)
        end
    end

    task.wait(0.2)

    if harvested > 0 then
        Log(string.format("🌾 Harvested %d crops", harvested))
    end

    if #GetReadyCropsWithPos(CachedRestaurant) == 0 then
        HarvestCooldownUntil = tick() + HarvestInterval
    end
end

local function HarvestIsReady()
    if tick() < HarvestCooldownUntil then
        return false
    end
    
    if not CachedRestaurant then
        CachedRestaurant = CachedClientRestaurant and CachedClientRestaurant.GetLocal()
    end
    
    if not CachedRestaurant then
        return false
    end
    
    local ReadyCrops = GetReadyCropsWithPos(CachedRestaurant)
    return #ReadyCrops > 0
end

task.spawn(function()
    while true do
        task.wait(0.3)

        if not AutoHarvestCropEnabled or not Running then
            continue
        end

        local ok, ready = pcall(HarvestIsReady)
        if not ok or not ready then
            continue
        end

        local doOk, err = pcall(function()
            HarvestDoWork()
        end)
        
        if not doOk then
            warn("[AutoHarvest] error: " .. tostring(err))
        end
    end
end)

