-- ============================================================
-- AUTO SHOP PURCHASE
-- ============================================================
local function PurchaseItemFromShop(itemName, quantity)
    quantity = quantity or 1
    local purchased = 0

    local ok = pcall(function()
        local ShopCmds = require(ReplicatedStorage.Framework.Client.ShopCmds)
        local Shop = require(ReplicatedStorage.Framework.Universal.Shop)

        if not ShopCmds or not Shop then
            Log("⚠ Shop modules not loaded")
            return
        end

        local offers = Shop.GetOffersRemaining(LocalPlayer)
        if not offers then
            Log("⚠ Shop offers not available")
            return
        end

        local OfferLookup = {}
        for itemDir, info in pairs(offers) do
            OfferLookup[itemDir._id] = itemDir
        end

        local itemDir = OfferLookup[itemName]
        if not itemDir then
            Log(string.format("⚠ Item '%s' not found in shop", itemName))
            return
        end

        if not Shop.MeetsItemRequirements(LocalPlayer, itemDir) then
            Log(string.format("⚠ Requirements not met for '%s'", itemName))
            return
        end

        while purchased < quantity do
            offers = Shop.GetOffersRemaining(LocalPlayer)
            local stock = offers[itemDir]

            if not stock or stock.Quantity <= 0 then
                Log(string.format("⚠ Out of stock: '%s' (%d/%d purchased)", itemName, purchased, quantity))
                break
            end

            if not Shop.MeetsItemRequirements(LocalPlayer, itemDir) then
                Log(string.format("⚠ Requirements no longer met for '%s' (%d/%d purchased)", itemName, purchased, quantity))
                break
            end

            local success = pcall(function()
                ShopCmds.Purchase(itemName)
            end)

            if not success then
                Log(string.format("⚠ Purchase failed: '%s'", itemName))
                break
            end

            purchased = purchased + 1
            Log(string.format("✓ Purchased: %s (%d/%d)", itemName, purchased, quantity))
            task.wait(0.25)
        end
    end)

    if not ok then
        Log("⚠ Error during purchase attempt for '" .. tostring(itemName) .. "'")
    end

    return purchased > 0
end

-- ============================================================
-- AUTO BUY PLOTS (v2.7)
--
-- Status/purchase logic disamain PERSIS kayak script "AUTO BUY PLOTS"
-- yang dikasih user: getStatus() ngecek Purchased/Purchasable/
-- Renderable/Hidden lewat rest:IsPackagePurchased(), GamepassRequired,
-- RequireAllPackages, UpgradeRequired (ProgressionUtil.IsGenericUnlocked),
-- RequiredSkillId+RequiredSkillLevel (SkillsCmds.GetLevel), dan urutan
-- Order buat nentuin package berikutnya yang "Renderable". getCurrencyAmount()
-- baca CurrencyId+CurrencyAmount atau tabel Currency di package.
--
-- INDEPENDEN: jalan terus di background (poll 2 detik, sama kayak
-- reference), gak nunggu Step/quest tertentu -- begitu status package
-- jadi Purchasable & cash cukup, langsung di-invoke
-- "Restaurant_PurchasePackage". Config.AutoBuyPlotIds kosong = beli
-- SEMUA package yang Purchasable; diisi array id = cuma beli yang ada
-- di list itu.
-- ============================================================
local AUTO_BUY_PLOTS_STATUS = { Purchased = 1, Purchasable = 2, Renderable = 3, Hidden = 4 }
local AUTO_BUY_PLOTS_REMOTE_KEY = "Restaurant_PurchasePackage"

local AutoBuyPlotsEnabled = false

local function GetSortedPlotPackages()
    local EntityPackage = GetEntityPackageModule()
    if not EntityPackage then
        return {}
    end

    local list = {}
    for _, pkg in pairs(EntityPackage) do
        if typeof(pkg) == "table" and pkg._id and not pkg.GamepassRequired then
            table.insert(list, pkg)
        end
    end
    table.sort(list, function(a, b)
        return (a.Order or math.huge) < (b.Order or math.huge)
    end)
    return list
end

local function GetPlotPackageStatus(player, pkg)
    local EntityPackage = GetEntityPackageModule()
    local Types = GetEntityPackageTypesModule()
    local ProgressionUtil = GetProgressionUtil()
    local SkillsCmds = GetSkillsCmds()

    if not EntityPackage or not Types or not ProgressionUtil or not SkillsCmds or not CachedClientRestaurant then
        return AUTO_BUY_PLOTS_STATUS.Hidden
    end

    local ok, rest = pcall(function()
        return CachedClientRestaurant.GetByPlayer(player)
    end)
    if not ok or not rest then
        return AUTO_BUY_PLOTS_STATUS.Hidden
    end

    if pkg.GamepassRequired then
        if rest:IsPackagePurchased(pkg) then
            return AUTO_BUY_PLOTS_STATUS.Purchased
        end
        return AUTO_BUY_PLOTS_STATUS.Hidden
    end

    local function allOtherPurchased()
        return Types.AllOtherPackagesPurchased(pkg, function(other)
            return rest:IsPackagePurchased(other)
        end)
    end

    if pkg.RequireAllPackages then
        if rest:IsPackagePurchased(pkg) then
            return AUTO_BUY_PLOTS_STATUS.Purchased
        end
        if not pkg.UpgradeRequired then
            if allOtherPurchased() then
                return AUTO_BUY_PLOTS_STATUS.Purchasable
            end
            return AUTO_BUY_PLOTS_STATUS.Hidden
        end
        if not ProgressionUtil.IsGenericUnlocked(player, pkg.UpgradeRequired) then
            return AUTO_BUY_PLOTS_STATUS.Hidden
        end
        if allOtherPurchased() then
            return AUTO_BUY_PLOTS_STATUS.Purchasable
        end
        return AUTO_BUY_PLOTS_STATUS.Hidden
    end

    local unlocked = (not pkg.UpgradeRequired) or ProgressionUtil.IsGenericUnlocked(player, pkg.UpgradeRequired)

    if pkg.RequiredSkillId and pkg.RequiredSkillLevel then
        local level = SkillsCmds.GetLevel(pkg.RequiredSkillId, player)
        if level < pkg.RequiredSkillLevel then
            unlocked = false
        end
    end

    local highestPurchasedOrder = 0
    for _, other in pairs(EntityPackage) do
        if not other.GamepassRequired and not other.RequiredSkillId
            and highestPurchasedOrder < other.Order and rest:IsPackagePurchased(other) then
            highestPurchasedOrder = other.Order
        end
    end

    if rest:IsPackagePurchased(pkg) then
        return AUTO_BUY_PLOTS_STATUS.Purchased
    end
    if unlocked then
        return AUTO_BUY_PLOTS_STATUS.Purchasable
    end
    if pkg.Order == highestPurchasedOrder + 1 then
        return AUTO_BUY_PLOTS_STATUS.Renderable
    end
    return AUTO_BUY_PLOTS_STATUS.Hidden
end

local function GetPlotPackageCurrencyAmount(pkg)
    if pkg.CurrencyId and pkg.CurrencyAmount then
        return pkg.CurrencyId, pkg.CurrencyAmount
    end
    if pkg.Currency then
        for id, amount in pairs(pkg.Currency) do
            return id, amount
        end
    end
    return nil, 0
end

task.spawn(function()
    while task.wait(2) do
        if not AutoBuyPlotsEnabled or not Running then
            continue
        end

        local Network = GetNetwork()
        local CurrencyCmds = GetCurrencyCmds()
        if not Network or not CurrencyCmds then
            continue
        end

        local allowedSet = nil
        if #Config.AutoBuyPlotIds > 0 then
            allowedSet = {}
            for _, id in ipairs(Config.AutoBuyPlotIds) do
                allowedSet[id] = true
            end
        end

        for _, pkg in ipairs(GetSortedPlotPackages()) do
            if allowedSet and not allowedSet[pkg._id] then
                continue
            end

            if GetPlotPackageStatus(LocalPlayer, pkg) ~= AUTO_BUY_PLOTS_STATUS.Purchasable then
                continue
            end

            local currencyId, price = GetPlotPackageCurrencyAmount(pkg)
            if currencyId then
                local cash = 0
                pcall(function() cash = CurrencyCmds.Get(currencyId) or 0 end)
                if cash < price then
                    continue
                end
            end

            pcall(function()
                Network.Invoke(AUTO_BUY_PLOTS_REMOTE_KEY, pkg._id)
                Log(string.format("✓ [AutoBuyPlots] Purchased: %s", pkg.Title or pkg._id))
            end)

            task.wait(0.5)
        end
    end
end)

-- ============================================================
-- AUTO BUY SHOP (v2.5) - Generic multi-item shop buyer.
--
-- Stock detection & buy pattern disamain PERSIS kayak script "BAGIAN
-- SHOP" (ShopKeeper) yang dikasih user:
--   1. Bangun OfferLookup dari Shop.GetOffersRemaining() (key = itemDir._id)
--   2. Buat tiap item target: cek requirement dulu (MeetsItemRequirements)
--   3. Baru masuk while-loop beli TERUS-MENERUS selama offers[itemDir]
--      punya Quantity > 0 & requirement masih kepenuhi
--   4. Begitu stock.Quantity <= 0 atau requirement gak kepenuhi lagi ->
--      break, lanjut ke item berikutnya
--
-- Outer loop (task.wait(0.9), SAMA kayak reference) cuma nentuin kapan
-- mulai nge-scan ulang offers/list -- BUKAN buy rate. Pembelian
-- aktualnya jalan continuous (delay 0.25s antar purchase) selama stock
-- masih ada, dan langsung stop detik itu juga pas stock habis, jadi
-- efeknya "auto buy hanya saat ada stock atau restock" seperti diminta,
-- bukan nembak Purchase() buta tiap 2 detik.
-- ============================================================
local AutoBuyShopEnabled = false

local function ResolveShopBuyList()
    local list = {}
    local seen = {}

    for _, itemName in ipairs(Config.ShopBuyItems) do
        if not seen[itemName] then
            seen[itemName] = true
            table.insert(list, itemName)
        end
    end

    if #Config.ShopBuyCategories > 0 then
        local ItemDirectory = GetItemDirectory()
        if ItemDirectory then
            local categorySet = {}
            for _, cat in ipairs(Config.ShopBuyCategories) do
                categorySet[cat] = true
            end

            for itemName, itemData in pairs(ItemDirectory) do
                if categorySet[itemData.ShopCategory] and itemData.ShopProbability and itemData.ShopQuantity then
                    if not seen[itemName] then
                        seen[itemName] = true
                        table.insert(list, itemName)
                    end
                end
            end
        end
    end

    return list
end

task.spawn(function()
    while task.wait(0.9) do
        if not AutoBuyShopEnabled or not Running then
            continue
        end

        local ShopBuyList = ResolveShopBuyList()
        if #ShopBuyList == 0 then
            continue
        end

        local okShop, ShopModule = pcall(function()
            return require(ReplicatedStorage.Framework.Universal.Shop)
        end)
        local okCmds, ShopCmdsModule = pcall(function()
            return require(ReplicatedStorage.Framework.Client.ShopCmds)
        end)

        if not okShop or not okCmds or not ShopModule or not ShopCmdsModule then
            continue
        end

        local offers = ShopModule.GetOffersRemaining(LocalPlayer)
        if not offers then
            continue
        end

        local OfferLookup = {}
        for itemDir, info in pairs(offers) do
            OfferLookup[itemDir._id] = itemDir
        end

        for _, itemName in ipairs(ShopBuyList) do
            if not AutoBuyShopEnabled or not Running then
                break
            end

            local itemDir = OfferLookup[itemName]
            if not itemDir then
                continue
            end

            if not ShopModule.MeetsItemRequirements(LocalPlayer, itemDir) then
                continue
            end

            while AutoBuyShopEnabled and Running do
                offers = ShopModule.GetOffersRemaining(LocalPlayer)
                local stock = offers[itemDir]

                if not stock then
                    break
                end

                if stock.Quantity <= 0 then
                    -- Gak ada stock/restock sekarang -> berhenti, biarin
                    -- tick berikutnya (0.9s) yang ngecek ulang.
                    break
                end

                if not ShopModule.MeetsItemRequirements(LocalPlayer, itemDir) then
                    break
                end

                local ok = pcall(function()
                    ShopCmdsModule.Purchase(itemName)
                end)

                if not ok then
                    break
                end

                Log(string.format("✓ [ShopBuy] Purchased: %s", itemName))
                task.wait(0.25)
            end
        end
    end
end)

-- ============================================================
-- AUTO PLACE TABLE & CHAIR (v2.4)
-- Target: restoran punya total 6 set (1 set = 1 Table + 2 Chair),
-- dihitung di SELURUH restaurant (semua floor), bukan cuma floor
-- tempat player berdiri saat ini.
--
-- Kalau stock Table/Chair di inventory gak cukup buat capai 6 set,
-- otomatis coba beli kekurangannya lewat PurchaseItemFromShop (reuse
-- fungsi yang sama dipakai quest type 2/Purchase). Kalau shop out of
-- stock atau cash kurang, PurchaseItemFromShop udah otomatis berhenti &
-- log warning sendiri -- watcher loop di bawah bakal nyoba lagi di tick
-- berikutnya, jadi efeknya "nunggu" seperti yang diminta, bukan macet.
--
-- Pattern placement (anchor + 2 chair di sisi berlawanan, rotasi chair
-- menghadap table, confirm via WaitForPlacementConfirmed) disamain
-- persis kayak script Auto Place Table & Chair yang dikasih user.
-- ============================================================
local FurnitureConfig = {
    TableItem = "Wooden Table",
    ChairItem = "Wooden Chair",
    TargetSets = 6,
    PlaceRotation = 0,
    BuildDebounce = 0.35,
    RotationOffset = 0, -- kalau abis dites arah Timur/Barat kebalik, ganti ke 180
}

local FurnitureDirectionToRotation = {
    ["0_-1"] = 0,   -- table di Utara (Y-1) dari chair
    ["1_0"] = 90,   -- table di Timur (X+1) dari chair
    ["0_1"] = 180,  -- table di Selatan (Y+1) dari chair
    ["-1_0"] = 270, -- table di Barat (X-1) dari chair
}

local FurnitureOppositeNeighborPairs = {
    { { 1, 0 }, { -1, 0 } }, -- kanan & kiri
    { { 0, 1 }, { 0, -1 } }, -- depan & belakang
}

-- Rotation chair = arah dari chair ke table, biar chair-nya "menghadap" meja.
local function ComputeChairRotation(chairVoxel, tableVoxel)
    local dx = tableVoxel.X - chairVoxel.X
    local dy = tableVoxel.Y - chairVoxel.Y
    local key = dx .. "_" .. dy
    local base = FurnitureDirectionToRotation[key] or 0
    return (base + FurnitureConfig.RotationOffset) % 360
end

-- "Wooden Table" -> "WoodenTable", dst.
local function DeriveSubclassName(itemName)
    if not itemName then
        return nil
    end
    return (itemName:gsub("%s+", ""))
end

-- Hitung entity subclass yang masih hidup. floor = nil berarti hitung di
-- SELURUH restaurant (semua floor), bukan cuma 1 floor tertentu.
local function GetPlacedFurnitureCount(restaurant, subclass, floor)
    if not subclass then
        return 0
    end
    local ok, entities = pcall(function()
        if floor then
            return restaurant:CollectSubclass(subclass, { Floor = floor })
        end
        return restaurant:CollectSubclass(subclass)
    end)
    if not ok or not entities then
        return 0
    end

    local count = 0
    for _, entity in ipairs(entities) do
        local okDestroyed, isDestroyed = pcall(function()
            return entity:IsDestroyed()
        end)
        if okDestroyed and not isDestroyed then
            count = count + 1
        end
    end
    return count
end

local function IsReservedFurnitureVoxel(voxel)
    local Restaurants = GetRestaurantsModule()
    if not Restaurants then
        return false
    end
    return voxel == Restaurants.EmployeeSpawnVoxel or voxel == Restaurants.DoorwayVoxel
end

local function GetNonDockPlaceableVoxels(restaurant, floor)
    local Types = GetEntityTypesModule()
    local ok, walkable = pcall(function()
        return restaurant:GetWalkableVoxels()
    end)

    if not ok or not walkable or not Types then
        return {}
    end

    local placeable = {}
    for _, voxel in ipairs(walkable) do
        if not IsReservedFurnitureVoxel(voxel) and not IsVoxelOccupied(restaurant, voxel, floor, Types) then
            local isDock = false

            local okFloor, floorEntity = pcall(function()
                return restaurant:GetEntityByVoxel(voxel, Types.HeightLevel.Floor, floor)
            end)
            if okFloor and floorEntity then
                local okSub, result = pcall(function()
                    return floorEntity:IsSubclass("Dock")
                end)
                isDock = okSub and result
            end

            if not isDock then
                table.insert(placeable, voxel)
            end
        end
    end

    return placeable
end

-- Lookup cepat by koordinat, buat cek & "pop" tetangga secara O(1).
local function BuildFurnitureVoxelLookup(voxels)
    local lookup = {}
    for _, v in ipairs(voxels) do
        lookup[v.X .. "_" .. v.Y] = v
    end
    return lookup
end

local function WaitForFurniturePlacementConfirmed(restaurant, voxel, floor, timeout)
    local Types = GetEntityTypesModule()
    if not Types then
        return false
    end

    local deadline = tick() + (timeout or 1.5)
    while tick() < deadline do
        local ok, entity = pcall(function()
            return restaurant:GetEntityByVoxel(voxel, Types.HeightLevel.Middle, floor)
        end)
        if ok and entity then
            return true
        end
        task.wait(0.1)
    end
    return false
end

local function PlaceFurnitureSets(restaurant, voxels, tableItem, chairItem, maxSets, tableStock, chairStock, floor)
    local Network = GetNetwork()
    if not Network then
        Log("⚠ Furniture: Network module not loaded")
        return 0, {}, {}
    end

    local lookup = BuildFurnitureVoxelLookup(voxels)
    local placedSets = 0
    local skippedAnchors = {}
    local incompleteAnchors = {}

    for _, anchor in ipairs(voxels) do
        if placedSets >= maxSets or tableStock <= 0 or chairStock < 2 then
            break
        end

        local anchorKey = anchor.X .. "_" .. anchor.Y
        if lookup[anchorKey] then

            local neighborKeys = nil
            for _, pair in ipairs(FurnitureOppositeNeighborPairs) do
                local key1 = (anchor.X + pair[1][1]) .. "_" .. (anchor.Y + pair[1][2])
                local key2 = (anchor.X + pair[2][1]) .. "_" .. (anchor.Y + pair[2][2])
                if lookup[key1] and lookup[key2] then
                    neighborKeys = { key1, key2 }
                    break
                end
            end

            if neighborKeys then
                lookup[anchorKey] = nil

                task.wait(FurnitureConfig.BuildDebounce)

                pcall(function()
                    Network.Fire("Build_Place", tableItem, anchor.X, anchor.Y, FurnitureConfig.PlaceRotation, floor)
                end)

                local tableConfirmed = WaitForFurniturePlacementConfirmed(restaurant, anchor, floor)

                if not tableConfirmed then
                    table.insert(skippedAnchors, anchor)
                else
                    tableStock = tableStock - 1

                    local chairsConfirmed = 0
                    for i = 1, 2 do
                        local chairVoxel = lookup[neighborKeys[i]]
                        lookup[neighborKeys[i]] = nil
                        local chairRotation = ComputeChairRotation(chairVoxel, anchor)

                        task.wait(FurnitureConfig.BuildDebounce)

                        pcall(function()
                            Network.Fire("Build_Place", chairItem, chairVoxel.X, chairVoxel.Y, chairRotation, floor)
                        end)

                        local chairConfirmed = WaitForFurniturePlacementConfirmed(restaurant, chairVoxel, floor, 2)

                        if chairConfirmed then
                            chairsConfirmed = chairsConfirmed + 1
                            chairStock = chairStock - 1
                        end
                    end

                    if chairsConfirmed >= 2 then
                        placedSets = placedSets + 1
                        Log(string.format("✓ Placed furniture set #%d (Table @ %d,%d)", placedSets, anchor.X, anchor.Y))
                    else
                        table.insert(incompleteAnchors, { anchor = anchor, chairsConfirmed = chairsConfirmed })
                    end
                end
            else
                table.insert(skippedAnchors, anchor)
            end
        end
    end

    return placedSets, skippedAnchors, incompleteAnchors
end

local AutoPlaceFurnitureEnabled = false
local AutoPlaceFurnitureRunning = false

local function TryAutoPlaceFurniture()
    if not AutoPlaceFurnitureEnabled or AutoPlaceFurnitureRunning then
        return
    end

    -- v2.8: begitu skill Farming ke-unlock, berhenti total beli/place
    -- Table & Chair -- fokus pindah ke Wheat Plant (lihat modul AUTO
    -- PLACE WHEAT PLANT di bawah).
    if IsFarmingSkillUnlocked() then
        return
    end

    if not CachedRestaurant then
        CachedRestaurant = CachedClientRestaurant and CachedClientRestaurant.GetLocal()
    end
    if not CachedRestaurant then
        return
    end

    local TableSubclass = DeriveSubclassName(FurnitureConfig.TableItem)
    local ChairSubclass = DeriveSubclassName(FurnitureConfig.ChairItem)

    -- Total di SELURUH restaurant (floor = nil), bukan cuma floor player
    -- berdiri, karena target 6 set ini target restaurant keseluruhan.
    local PlacedTables = GetPlacedFurnitureCount(CachedRestaurant, TableSubclass, nil)
    local PlacedChairs = GetPlacedFurnitureCount(CachedRestaurant, ChairSubclass, nil)
    local PlacedSets = math.min(PlacedTables, math.floor(PlacedChairs / 2))
    local NeededSets = math.max(0, FurnitureConfig.TargetSets - PlacedSets)

    if NeededSets <= 0 then
        -- Target 6 set udah tercapai, gak ada yang perlu dikerjain lagi
        return
    end

    local TableStock = GetItemStock(FurnitureConfig.TableItem)
    local ChairStock = GetItemStock(FurnitureConfig.ChairItem)

    local MaxSetsByStock = math.min(NeededSets, TableStock, math.floor(ChairStock / 2))

    if MaxSetsByStock <= 0 then
        -- Stock inventory gak cukup buat 1 set pun -> coba beli
        -- kekurangannya dari shop. Kalau shop out-of-stock atau cash
        -- kurang, PurchaseItemFromShop berhenti & log sendiri; watcher
        -- loop bakal nyoba lagi tick berikutnya (efeknya "nunggu").
        local tableNeeded = math.max(0, NeededSets - TableStock)
        local chairNeeded = math.max(0, (NeededSets * 2) - ChairStock)

        if tableNeeded > 0 then
            Log(string.format("🪑 Butuh %s x%d buat capai target %d set (stock: %d), coba beli...",
                FurnitureConfig.TableItem, tableNeeded, FurnitureConfig.TargetSets, TableStock))
            PurchaseItemFromShop(FurnitureConfig.TableItem, tableNeeded)
        end

        if chairNeeded > 0 then
            Log(string.format("🪑 Butuh %s x%d buat capai target %d set (stock: %d), coba beli...",
                FurnitureConfig.ChairItem, chairNeeded, FurnitureConfig.TargetSets, ChairStock))
            PurchaseItemFromShop(FurnitureConfig.ChairItem, chairNeeded)
        end

        return
    end

    AutoPlaceFurnitureRunning = true

    task.spawn(function()
        local Floor = GetPlayerFloor(CachedRestaurant)
        local Voxels = GetNonDockPlaceableVoxels(CachedRestaurant, Floor)

        if #Voxels == 0 then
            Log("⚠ Furniture: no empty non-dock tiles found on this floor")
            AutoPlaceFurnitureRunning = false
            return
        end

        Log(string.format("🪑 Placing %d furniture set (progress: %d/%d set)",
            MaxSetsByStock, PlacedSets, FurnitureConfig.TargetSets))

        local PlacedNow, Skipped, Incomplete = PlaceFurnitureSets(
            CachedRestaurant,
            Voxels,
            FurnitureConfig.TableItem,
            FurnitureConfig.ChairItem,
            MaxSetsByStock,
            TableStock,
            ChairStock,
            Floor
        )

        if PlacedNow < MaxSetsByStock then
            local reasonParts = {}
            if #Skipped > 0 then
                table.insert(reasonParts, string.format("%d anchor gak punya pasangan sisi berlawanan yang kosong", #Skipped))
            end
            if #Incomplete > 0 then
                table.insert(reasonParts, string.format("%d Table kepasang tapi Chair-nya gagal/kurang", #Incomplete))
            end
            Log(string.format("⚠ Furniture: only %d/%d set placed this pass -- %s",
                PlacedNow, MaxSetsByStock,
                #reasonParts > 0 and table.concat(reasonParts, "; ") or "unknown reason"))
        else
            Log(string.format("✓ Furniture: %d set placed this pass", PlacedNow))
        end

        AutoPlaceFurnitureRunning = false
    end)
end

local FurnitureWatcherRunning = false
local function RunFurnitureWatcher()
    if FurnitureWatcherRunning then
        return
    end
    FurnitureWatcherRunning = true

    task.spawn(function()
        while AutoPlaceFurnitureEnabled and Running do
            if not AutoPlaceFurnitureRunning then
                TryAutoPlaceFurniture()
            end
            task.wait(2)
        end
        FurnitureWatcherRunning = false
    end)
end

