local function ParsePurchaseGoal(goalData)
    local quantity = goalData.Amount or 1
    local itemName = nil

    pcall(function()
        if goalData.GoalData and goalData.GoalData.Goal then
            local goal = goalData.GoalData.Goal
            if goal.ItemId then
                itemName = goal.ItemId
            elseif goal.Item then
                itemName = goal.Item
            elseif goal.Id then
                itemName = goal.Id
            end
        end
    end)

    local ItemDirectory = GetItemDirectory()

    local function ResolveAgainstDirectory(candidate)
        if not candidate or not ItemDirectory then
            return candidate
        end
        if ItemDirectory[candidate] then
            return candidate
        end
        local lowerCandidate = candidate:lower()
        for key, _ in pairs(ItemDirectory) do
            if key:lower() == lowerCandidate then
                return key
            end
        end
        return nil
    end

    if itemName then
        local resolved = ResolveAgainstDirectory(itemName)
        if resolved then
            return resolved, quantity
        end
    end

    if goalData.Name and ItemDirectory then
        local name = goalData.Name

        local patterns = {
            "[Bb]uy%s+a?n?%s*(.+)!?$",
            "[Pp]urchase%s+a?n?%s*(.+)!?$",
            "[Bb]eli%s+(.+)!?$",
        }

        local extracted = nil
        for _, pattern in ipairs(patterns) do
            local match = name:match(pattern)
            if match then
                extracted = match:gsub("!$", ""):gsub("^%s+", ""):gsub("%s+$", "")
                break
            end
        end

        if extracted then
            local resolved = ResolveAgainstDirectory(extracted)
            if resolved then
                return resolved, quantity
            end

            local lowerExtracted = extracted:lower()
            for key, _ in pairs(ItemDirectory) do
                local lowerKey = key:lower()
                if lowerKey:find(lowerExtracted, 1, true) or lowerExtracted:find(lowerKey, 1, true) then
                    Log(string.format("DEBUG: Fuzzy matched '%s' -> ItemDirectory key '%s'", extracted, key))
                    return key, quantity
                end
            end

            Log(string.format("⚠ Extracted '%s' from quest text but no ItemDirectory match found", extracted))
        end
    end

    return itemName, quantity
end

