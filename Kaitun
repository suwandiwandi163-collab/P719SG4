local AutoDishwasherEnabled = false

-- ============================================================
-- v2.6: Deteksi dishwasher/sink penuh (ACCURATE), disamain persis kayak
-- "JinHub Auto Dishwasher (Fixed)" yang dikasih user.
--
-- Dulu GetDishwasherEntity() gak pernah cek kapasitas sama sekali --
-- begitu ada dishwasher (TargetDishwasherId, punya sendiri, atau
-- fallback manapun), langsung dipakai tanpa peduli udah penuh atau
-- belum. Kalau semua dishwasher penuh, player tetap TP & coba
-- DepositDishPlayer yang gagal diam-diam (server nolak), lalu loop
-- ulang lagi 0.3 detik kemudian -- gak pernah idle.
--
-- Sekarang: isDishwasherFull() pakai ClientDishwasher.ComputeCapacity()
-- + GetSession("ReservedCount") + GetSession("CompletionTimestamp")
-- buat hitung slot yang lagi kepake (reserved + yang masih aktif
-- nyuci), dibandingin ke capacity. GetDishwasherEntity() sekarang:
--   1. Sticky target -- tetep pake TargetDishwasherId LAMA selama itu
--      belum penuh (biar gak lompat-lompat target tiap tick)
--   2. Kalau sticky target penuh/gak ada -> prioritas dishwasher milik
--      sendiri yang belum penuh
--   3. Fallback -> dishwasher MANAPUN yang belum penuh
--   4. Semua penuh -> return nil, loop di bawah auto-idle (gak TP)
-- ============================================================
local function IsDishwasherFull(dishwasher)
    local ClientDishwasher = GetClientDishwasher()
    if not ClientDishwasher or not ClientDishwasher.ComputeCapacity then
        return true -- gagal load module -> anggap penuh, skip biar aman
    end

    local ok, capacity = pcall(ClientDishwasher.ComputeCapacity, dishwasher)
    if not ok or not capacity then
        return true -- gagal baca capacity -> anggap penuh, skip biar aman
    end

    local okReserved, reserved = pcall(function()
        return dishwasher:GetSession("ReservedCount")
    end)
    reserved = (okReserved and reserved) or 0

    local okTs, completionTs = pcall(function()
        return dishwasher:GetSession("CompletionTimestamp")
    end)

    local activeCount = 0
    if okTs and completionTs and workspace:GetServerTimeNow() < completionTs then
        activeCount = 1
    end

    return (reserved + activeCount) >= capacity
end

local function GetDishwasherEntity()
    if not CachedRestaurant then
        CachedRestaurant = CachedClientRestaurant and CachedClientRestaurant.GetLocal()
    end
    if not CachedRestaurant then
        return nil
    end

    -- Sticky target: tetep pake target lama SELAMA belum penuh
    local dishwasherId = LocalPlayer:GetAttribute("TargetDishwasherId")
    if dishwasherId then
        local entity = CachedRestaurant:GetEntity(dishwasherId)
        if entity and not IsDishwasherFull(entity) then
            return entity
        end
    end

    -- Prioritas: dishwasher MILIK SENDIRI yang belum penuh
    for _, dishwasher in ipairs(CachedRestaurant:CollectSubclass("Dishwasher")) do
        local okLocal, isLocal = pcall(function()
            return dishwasher:IsLocal()
        end)
        if okLocal and isLocal and not IsDishwasherFull(dishwasher) then
            return dishwasher
        end
    end

    -- Fallback: dishwasher MANAPUN yang belum penuh
    for _, dishwasher in ipairs(CachedRestaurant:CollectSubclass("Dishwasher")) do
        if not IsDishwasherFull(dishwasher) then
            return dishwasher
        end
    end

    return nil -- semua penuh / gak ada dishwasher
end

