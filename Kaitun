    if not CachedRestaurant then
        return false
    end

    for _, stove in ipairs(CachedRestaurant:CollectSubclass("Stove")) do
        local isLocalOk, isLocal = pcall(function()
            return stove:IsLocal()
        end)
        if isLocalOk and isLocal and IsStoveFree(stove) then
            return true
        end
    end
    return false
end

