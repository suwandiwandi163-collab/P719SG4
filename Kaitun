local function GetActiveGoals()
    local goals = {}

    local Saving = GetSaving()
    if Saving then
        local ok, saveData = pcall(function()
            return Saving.Get()
        end)

        if ok and saveData and saveData.Goals then
            local goalCount = 0
            for _ in pairs(saveData.Goals) do goalCount = goalCount + 1 end

            if goalCount > 0 then
                Log(string.format("DEBUG: Found %d goals in save data", goalCount))
            end

            for goalId, goalData in pairs(saveData.Goals) do
                if goalData.Goal then
                    -- v3.7: FILTER MILESTONE QUEST
                    -- Milestone quest punya Tag2 yang isinya Quest ID dengan prefix "Milestone"
                    -- atau bisa cek Tag1 == "Milestone"
                    local isMilestone = false
                    
                    -- Check Tag1
                    if goalData.Tag1 and tostring(goalData.Tag1):lower():find("milestone") then
                        isMilestone = true
                        Log(string.format("DEBUG: Skipped MILESTONE quest (Tag1): %s", goalId))
                    end
                    
                    -- Check Tag2 (Quest ID)
                    if goalData.Tag2 and tostring(goalData.Tag2):lower():find("milestone") then
                        isMilestone = true
                        Log(string.format("DEBUG: Skipped MILESTONE quest (Tag2): %s", goalId))
                    end
                    
                    -- Check Goal.QuestId if exists
                    if goalData.Goal.QuestId and tostring(goalData.Goal.QuestId):lower():find("milestone") then
                        isMilestone = true
                        Log(string.format("DEBUG: Skipped MILESTONE quest (QuestId): %s", goalId))
                    end
                    
                    -- SKIP milestone quest dari automation
                    if isMilestone then
                        continue
                    end

                    local displayName = goalId

                    pcall(function()
                        local GoalTypes = require(ReplicatedStorage.Framework.Types.GoalTypes)
                        if GoalTypes.GoalToString then
                            displayName = GoalTypes.GoalToString(goalData.Goal)
                        end
                    end)

                    goals[goalId] = {
                        Name = displayName,
                        Progress = goalData.Progress or 0,
                        Amount = goalData.Goal.Amount or 1,
                        Completed = goalData.Completed or false,
                        GoalData = goalData,
                        Tag1 = goalData.Tag1,
                        Type = goalData.Goal.Type,
                        GoalId = goalId
                    }

                    Log(string.format("DEBUG: Goal %s | Type: %d | Progress: %d/%d | Completed: %s",
                        displayName, goalData.Goal.Type or 0, goalData.Progress or 0,
                        goalData.Goal.Amount or 1, tostring(goalData.Completed)))
                end
            end

            if next(goals) then
                return goals
            else
                Log("DEBUG: No valid goals found in save data")
            end
        else
            Log("DEBUG: Save data or Goals table not available")
        end
    else
        Log("DEBUG: Saving module not loaded")
    end

    return goals
end

-- ============================================================
-- SelectFocusQuest - SATU-SATUNYA tempat logic prioritas quest.
-- Dipakai bareng oleh AutoCompleteQuests() (yang benerin actionnya) dan
-- monitor loop di bawah (yang cuma update GUI). Kalau dua tempat itu
-- makai fungsi seleksi yang beda, hasilnya bisa beda quest -> GUI flicker.
-- Priority: Serve (1/8) > Cook (10) > Earn (3) > Purchase (2) > Place (12)
--           > Hire (4) > Dish (5) > Harvest (7)
-- ============================================================
local QuestPriorityOrder = {1, 8, 10, 3, 2, 12, 4, 5, 7}

local function SelectFocusQuest(activeGoals)
    if not activeGoals or not next(activeGoals) then
        return nil
    end

    -- Phase 1: completed quest diklaim duluan, apapun tipenya
    for _, goalData in pairs(activeGoals) do
        if goalData.Completed then
            return goalData
        end
    end

    -- Phase 2: pilih SATU uncompleted quest berdasarkan priority order
    for _, priorityType in ipairs(QuestPriorityOrder) do
        for _, goalData in pairs(activeGoals) do
            if not goalData.Completed and goalData.Type == priorityType then
                return goalData
            end
        end
    end

    -- Fallback: tipe quest yang gak ada di priority order, ambil yang
    -- pertama ketemu (masih lebih baik daripada nggak milih sama sekali)
    for _, goalData in pairs(activeGoals) do
        if not goalData.Completed then
            return goalData
        end
    end

    return nil
end

