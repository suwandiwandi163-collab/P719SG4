-- ============================================================
-- Teleport helpers - SIMPLE METHOD (v3.6)
-- Based on global.lua - TP di BELAKANG target 5.5 studs + 3 studs ke atas
-- Character jatuh natural dengan gravity
-- ============================================================
local function GetRootPart()
    local character = LocalPlayer.Character
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function GetAnchorPosition(part)
    if not part then
        return nil
    end
    local anchor = part:FindFirstChild("InteractAttachment") or part
    if anchor:IsA("Attachment") then
        return anchor.WorldPosition
    end
    return anchor.Position
end

-- Get LookVector dari part untuk tentukan arah belakang
local function GetPartLookVector(part)
    if not part then
        return Vector3.new(0, 0, -1)
    end
    -- Ambil LookVector dari part CFrame
    return part.CFrame.LookVector
end

-- Simple TP: position di BELAKANG target + 3 studs ke atas + keep current rotation
-- Character spawn di atas terus jatuh natural (gravity)
local function TeleportToPart(part, backDistance, heightOffset)
    backDistance = backDistance or 5.5
    heightOffset = heightOffset or 3 -- 3 studs ke atas untuk fall effect
    
    local rootPart = GetRootPart()
    if not rootPart then
        return false
    end

    local targetPart = part
    if part:IsA("Model") then
        targetPart = part.PrimaryPart
    end
    if not targetPart then
        return false
    end

    local anchorPosition = GetAnchorPosition(targetPart)
    if not anchorPosition then
        return false
    end

    -- Get arah belakang dari target (opposite LookVector)
    local lookVector = GetPartLookVector(targetPart)
    local backOffset = -lookVector * backDistance  -- BELAKANG (negative)
    
    -- Position di belakang target + offset ke atas (fall effect)
    local backPosition = anchorPosition + backOffset + Vector3.new(0, heightOffset, 0)
    
    -- Keep current rotation (natural)
    local currentRotation = rootPart.CFrame - rootPart.CFrame.Position

    rootPart.CFrame = CFrame.new(backPosition) * currentRotation
    return true
end

local function TeleportToEntity(entity, backDistance, heightOffset)
    if not entity then
        return false
    end
    local ok, model = pcall(function()
        return entity:GetModel()
    end)
    if not ok or not model then
        return false
    end
    return TeleportToPart(model, backDistance, heightOffset)
end

