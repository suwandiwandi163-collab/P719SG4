-- AUTO BUY MISSING ITEMS + LOAD LAYOUT (v3.0)
--
-- Trigger: dipanggil SEKALI otomatis begitu skill Service (panel Skills)
-- nyampe Level 10 -- dipicu bareng monitor AUTO STOP di bawah, pakai
-- Config.LayoutCode (text yang di-paste di textbox GUI).
--
-- Pattern disamain PERSIS kayak script "AUTO BUY MISSING ITEMS + LOAD
-- LAYOUT" yang dikasih user:
--   1. EntityItemMap/WallItemMap dibangun dari Item directory (item yang
--      punya tag "Buildable"), key = LinkedEntityId/LinkedWallId
--   2. computeRequiredCounts() ngitung kebutuhan per item dari
--      layoutData.Entities/Walls (via LayoutsCmds.GetData setelah
--      Layouts_Import ke slot kosong sementara)
--   3. tryBuyItem() cek Shop.MeetsItemRequirements -> Shop.GetOffersRemaining
--      (stock) -> Shop.CanAfford, baru ShopCmds.Purchase(item._id)
--   4. Setelah semua item kekumpul (atau sebagian, tetap lanjut),
--      Network.Invoke("Layouts_Load", code), lalu Layouts_Delete slot
--      sementara-nya
--
-- Ini TERPISAH dari Step 2/3 lama (ImportLayout/CheckWheatAndApplyLayout
-- yang masih pakai loadstring) -- fitur ini jalan independen begitu
-- skill Service Level 10 tercapai, gak perlu nunggu Step tertentu.
-- ============================================================
local AutoLoadLayoutBusy = false

local function BuildLayoutItemMaps()
    local ItemDirectory = GetItemDirectory()
    local ItemUtil = GetItemUtilModule()
    local entityMap, wallMap = {}, {}

    if not ItemDirectory or not ItemUtil then
        return entityMap, wallMap
    end

    for _, item in pairs(ItemDirectory) do
        local okTag, hasTag = pcall(function()
            return ItemUtil.HasTag(item, "Buildable")
        end)
        if okTag and hasTag then
            if item.LinkedEntityId then
                entityMap[item.LinkedEntityId] = item
            end
            if item.LinkedWallId then
                wallMap[item.LinkedWallId] = item
            end
        end
    end

    return entityMap, wallMap
end

local function ComputeLayoutRequiredCounts(layoutData)
    local required = {}
    if not layoutData then
        return required
    end

    local entityMap, wallMap = BuildLayoutItemMaps()

    for _, e in ipairs(layoutData.Entities or {}) do
        local item = entityMap[e.DirId]
        if item then
            required[item] = (required[item] or 0) + 1
        end
    end
    for _, w in ipairs(layoutData.Walls or {}) do
        local item = wallMap[w.DirId]
        if item then
            required[item] = (required[item] or 0) + 1
        end
    end

    return required
end

local function FindFreeLayoutSlot()
    local Saving = GetSaving()
    local LayoutsType = GetLayoutsTypeModule()
    if not Saving or not LayoutsType then
        return nil
    end

    local ok, save = pcall(function()
        return Saving.Get()
    end)
    if not ok or not save or not save.Layouts then
        return nil
    end

    for i = 1, LayoutsType.MaxSlots do
        if not save.Layouts[tostring(i)] then
            return i
        end
    end
    return nil
end

local function WaitForLayoutData(slot, timeout)
    timeout = timeout or 10
    local LayoutsCmds = GetLayoutsCmds()
    if not LayoutsCmds then
        return nil
    end

    local start = tick()
    while tick() - start < timeout do
        local ok, data = pcall(function()
            return LayoutsCmds.GetData(slot)
        end)
        if ok and data then
            return data
        end
        task.wait(0.25)
    end
    return nil
end

local function TryBuyLayoutItem(item)
    local Shop = GetShopModule()
    local ShopCmds = GetShopCmdsModule()
    if not Shop or not ShopCmds then
        return false, "Shop module gak ke-load"
    end

    local okReq, meetsReq = pcall(function()
        return Shop.MeetsItemRequirements(LocalPlayer, item)
    end)
    if not okReq or not meetsReq then
        return false, "item terkunci (requirement belum kepenuhin)"
    end

    local okOffers, offers = pcall(function()
        return Shop.GetOffersRemaining(LocalPlayer)
    end)
    local offer = okOffers and offers and offers[item]
    if not offer or offer.Quantity <= 0 then
        return false, "stock shop lagi habis"
    end

    local okAfford, canAfford = pcall(function()
        return Shop.CanAfford(LocalPlayer, item)
    end)
    if not okAfford or not canAfford then
        return false, "cash/diamond gak cukup"
    end

    local ok, err = pcall(function()
        return ShopCmds.Purchase(item._id)
    end)
    return ok, err
end

local function BuyMissingLayoutItems(required)
    local InventoryCmds = GetInventoryCmds()
    local allBought = true

    for item, needed in pairs(required) do
        local owned = 0
        if InventoryCmds then
            pcall(function()
                owned = InventoryCmds.Count(item) or 0
            end)
        end
        local shortage = needed - owned

        for _ = 1, shortage do
            local ok, err = TryBuyLayoutItem(item)
            if not ok then
                allBought = false
                Log(string.format("⚠ [AutoLoadLayout] Gagal beli '%s': %s",
                    item.DisplayName or item._id, tostring(err)))
                break
            end
            Log(string.format("✓ [AutoLoadLayout] Bought: %s", item.DisplayName or item._id))
            task.wait(0.3)
        end
    end

    return allBought
end

local function AutoLoadLayoutWithBuy(code)
    if AutoLoadLayoutBusy then
        return
    end
    if not code or code:match("^%s*$") or code == "Paste Layout Code Here..." then
        Log("⚠ [AutoLoadLayout] Layout code kosong, skip")
        return
    end

    local LayoutsCmds = GetLayoutsCmds()
    local Network = GetNetwork()
    if not LayoutsCmds or not Network then
        Log("⚠ [AutoLoadLayout] LayoutsCmds/Network module gak ke-load")
        return
    end

    local okUnlocked, unlocked = pcall(function()
        return LayoutsCmds.IsUnlocked()
    end)
    if not okUnlocked or not unlocked then
        Log("⚠ [AutoLoadLayout] Layouts belum unlock (level Service kurang)")
        return
    end

    AutoLoadLayoutBusy = true
    Log("🏗️ [AutoLoadLayout] Mulai cek & beli item yang kurang buat layout...")

    task.spawn(function()
        local freeSlot = FindFreeLayoutSlot()
        if not freeSlot then
            Log("⚠ [AutoLoadLayout] Semua slot layout penuh, gak ada slot kosong buat import sementara")
            AutoLoadLayoutBusy = false
            return
        end

        local importOk, importErr = Network.Invoke("Layouts_Import", freeSlot, code)
        if not importOk then
            Log("⚠ [AutoLoadLayout] Gagal import code layout: " .. tostring(importErr))
            AutoLoadLayoutBusy = false
            return
        end

        local data = WaitForLayoutData(freeSlot, 10)
        if not data then
            Log("⚠ [AutoLoadLayout] Timeout nunggu data layout ke-sync")
            pcall(Network.Invoke, "Layouts_Delete", freeSlot)
            AutoLoadLayoutBusy = false
            return
        end

        local required = ComputeLayoutRequiredCounts(data)
        local gotEverything = BuyMissingLayoutItems(required)

        if not gotEverything then
            Log("⚠ [AutoLoadLayout] Sebagian item gak berhasil dibeli, tetep nyoba load...")
        end

        local loadOk, loadErr = Network.Invoke("Layouts_Load", code)
        if loadOk then
            Log("✓ [AutoLoadLayout] Layout berhasil di-load (reconnecting...)")
        else
            Log("⚠ [AutoLoadLayout] Gagal load layout: " .. tostring(loadErr))
        end

        pcall(Network.Invoke, "Layouts_Delete", freeSlot)
        AutoLoadLayoutBusy = false
    end)
end

