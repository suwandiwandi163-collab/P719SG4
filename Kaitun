local function WaitForRestaurant()
    Log("Waiting for restaurant to load...")
    local ClientRestaurant = GetClientRestaurant()
    if not ClientRestaurant then
        return nil
    end

    local restaurant = nil
    local attempts = 0
    local maxAttempts = 20

    repeat
        attempts = attempts + 1
        restaurant = ClientRestaurant.GetLocal()
        if not restaurant then
            Log(string.format("Restaurant not ready... (%d/%d)", attempts, maxAttempts))
            task.wait(1)
        end
    until restaurant or attempts >= maxAttempts

    if restaurant then
        Log("✓ Restaurant loaded successfully!")

        local ok, info = pcall(function()
            local entities = restaurant:GetEntities()
            local customers = restaurant:CollectSubclass("Customer")
            local stands = restaurant:CollectSubclass("OrderStand")

            return string.format("Entities: %d | Customers: %d | Stands: %d",
                #entities, #customers, #stands)
        end)

