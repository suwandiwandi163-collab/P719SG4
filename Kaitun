local function IsStoveFree(stove)
    local ApplianceTypes = GetApplianceTypesModule()
    if not ApplianceTypes or not ApplianceTypes.EncodeSlotKey then
        -- Fail-open: kalau module gak ke-load, jangan block cooking sama
        -- sekali, mending tetep jalan seperti behavior lama.
        return true
    end
    local EncodeSlotKey = ApplianceTypes.EncodeSlotKey

    local ok, directory = pcall(function()
        return stove:GetDirectory()
    end)
    local slots = (ok and directory and directory.StoveSlots) or 1

    for i = 1, slots do
        local okSession, cooking = pcall(function()
            return stove:GetSession(EncodeSlotKey("Cooking", i))
        end)
        if okSession and not cooking then
            return true
        end
    end
    return false
end

